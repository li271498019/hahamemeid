# haha-indexer env template — copy to /etc/haha/indexer.env (0600) and
# fill in the real values ON THE SERVER. Never commit the real file.
# DATABASE_URL: Postgres on localhost only.
DATABASE_URL=postgresql://haha:<password>@127.0.0.1:5432/haha_indexer
# BSC_RPC_URLS: comma-separated public endpoints, no keys. The server's
# env file decides the real list; these are examples only.
BSC_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io,https://bsc.publicnode.com
