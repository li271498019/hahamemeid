# /etc/haha/agent-chat.env  (root 0600 on the server). Placeholders only; never commit real values.
CHANNEL_API_KEY=<random bearer token>
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=haha_indexer
PGUSER=haha
PGPASSWORD=<password>
INDEXER_API_BASE=http://127.0.0.1:8787
IMAGE_DIR=/var/www/haha.meme/agent-images
PUBLIC_BASE_URL=https://haha.meme/agent-chat
