# EXAMPLE ONLY. Real file: /etc/nginx/haha-rpc-secrets.conf (root:root 0600, server only, never commit). `nginx -T` prints it.
upstream haha_rpc_ankr {
    server rpc.ankr.com:443 max_fails=0;
    keepalive 16;
    keepalive_timeout 60s;
    keepalive_requests 1000;
}
map $server_name $haha_ankr_host  { default "rpc.ankr.com"; }
map $server_name $haha_ankr1_path { default "/bsc/<ANKR_KEY_1>"; }
map $server_name $haha_ankr2_path { default "/bsc/<ANKR_KEY_2>"; }
