[Unit]
Description=haha.meme V1 indexer HTTP API
After=network-online.target postgresql.service haha-indexer.service
Wants=network-online.target

[Service]
Type=simple
User=haha
Group=haha
WorkingDirectory=/opt/haha-indexer
EnvironmentFile=/etc/haha/indexer.env
ExecStart=/usr/bin/python3 /opt/haha-indexer/api.py
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/haha-indexer /var/www/validations

[Install]
WantedBy=multi-user.target
