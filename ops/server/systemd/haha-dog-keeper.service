[Unit]
Description=Haha Dog snapshot keeper (HahaDog.processQueue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hahadog-keeper
Group=hahadog-keeper
# key + RPC urls are exposed read-only to this service only, in a private tmpfs ($CREDENTIALS_DIRECTORY); never copied to disk
LoadCredential=admin-signer.env:/etc/haha/admin-signer.env
LoadCredential=indexer.env:/etc/haha/indexer.env
Environment=HAHA_DOG_ADDRESS=0x26f88A5db4925e9aFa35B1096FdD6DBa09f056c6
Environment=KEEPER_EXPECT_ADDRESS=0x083A467259f12602E9053bBAe2b3Fd5B62976Ef7
Environment=INTERVAL=4
Environment=MAX_STEPS=100
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/haha-dog-keeper
ExecStart=/opt/haha-season1/venv/bin/python /opt/haha-dog-keeper/keeper.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryMax=200M
CPUQuota=20%
LogRateLimitIntervalSec=30
LogRateLimitBurst=50

[Install]
WantedBy=multi-user.target
