# validator 服务环境变量模板
# 复制到服务器的环境变量文件（0600），填真实值，不要提交到仓库。
# 管理员密钥文件路径（文件里是 ADMIN_PRIVATE_KEY=0x...）
VALIDATOR_ADMIN_ENV=/etc/haha/admin-signer.env
# 索引器环境变量文件路径
INDEXER_ENV=/etc/haha/indexer.env
# BSC RPC（公开节点，无密钥）
VALIDATOR_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io,https://bsc.publicnode.com
VALIDATOR_CHAIN_ID=56
VALIDATOR_DEPLOY_BLOCK=135619015
VALIDATOR_POLL_INTERVAL=30
VALIDATOR_STATE_DIR=/opt/haha-validation/data
VALIDATOR_IPFS_GATEWAY=https://ipfs.io/ipfs/
